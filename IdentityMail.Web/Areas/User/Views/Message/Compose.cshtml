@model ComposeMessageDto
@{
    ViewData["Title"] = "Yeni Mesaj";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as IEnumerable<dynamic>;
}

<div class="p-6 md:p-8 max-w-3xl mx-auto">
    <div class="flex flex-col gap-6">

        <h2 class="font-display-sm text-display-sm text-on-surface">Yeni Mesaj</h2>

        <div asp-validation-summary="ModelOnly" class="text-error text-body-sm-reg bg-error-container/40 p-3 rounded-lg border border-error/20 empty:hidden"></div>

        <form method="post" asp-area="User" asp-controller="Message" asp-action="Compose" id="composeForm"
              class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col">

            <input type="hidden" asp-for="ParentMessageId" />
            <input type="hidden" asp-for="ExistingDraftId" />

            <!-- Form Alanları -->
            <div class="flex-1 overflow-y-auto p-6 space-y-5">

                <!-- Kime -->
                <div>
                    <div class="flex items-center border-b border-outline-variant pb-2 focus-within:border-primary transition-colors">
                        <label class="w-20 font-body-sm-medium text-body-sm-medium text-on-surface-variant shrink-0" asp-for="ReceiverEmail">Kime</label>
                        <input class="flex-1 bg-transparent border-none p-0 focus:ring-0 font-body-sm-reg text-body-sm-reg text-on-surface placeholder:text-outline"
                               type="email" asp-for="ReceiverEmail" placeholder="ornek@site.com" autocomplete="off" />
                    </div>
                    <span asp-validation-for="ReceiverEmail" class="text-error text-body-sm-reg text-xs"></span>
                </div>

                <!-- Konu -->
                <div>
                    <div class="flex items-center border-b border-outline-variant pb-2 focus-within:border-primary transition-colors">
                        <label class="w-20 font-body-sm-medium text-body-sm-medium text-on-surface-variant shrink-0" asp-for="Subject">Konu</label>
                        <input class="flex-1 bg-transparent border-none p-0 focus:ring-0 font-body-sm-reg text-body-sm-reg text-on-surface placeholder:text-outline"
                               type="text" asp-for="Subject" placeholder="Kısa bir konu başlığı" />
                    </div>
                    <span asp-validation-for="Subject" class="text-error text-body-sm-reg text-xs"></span>
                </div>

                <!-- Kategori -->
                <div class="flex items-center border-b border-outline-variant pb-2 focus-within:border-primary transition-colors relative">
                    <label class="w-20 font-body-sm-medium text-body-sm-medium text-on-surface-variant shrink-0" asp-for="CategoryId">Kategori</label>
                    <select class="flex-1 bg-transparent border-none p-0 pr-8 focus:ring-0 font-body-sm-reg text-body-sm-reg text-on-surface appearance-none cursor-pointer"
                            asp-for="CategoryId">
                        <option value="">Kategori seçilmedi</option>
                        @if (categories != null)
                        {
                            foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                    <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant">arrow_drop_down</span>
                </div>

                <!-- Mesaj İçeriği -->
                <div>
                    <div class="flex flex-col border border-outline-variant rounded-lg overflow-hidden focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all h-[300px]">
                        <!-- Toolbar şimdilik dekoratif -->
                        <div class="flex items-center gap-1 bg-surface-container-low px-3 py-2 border-b border-outline-variant">
                            <button type="button" class="p-1.5 text-outline-variant rounded transition-colors cursor-not-allowed" title="Kalın (yakında)" disabled>
                                <span class="material-symbols-outlined text-[18px]">format_bold</span>
                            </button>
                            <button type="button" class="p-1.5 text-outline-variant rounded transition-colors cursor-not-allowed" title="İtalik (yakında)" disabled>
                                <span class="material-symbols-outlined text-[18px]">format_italic</span>
                            </button>
                            <button type="button" class="p-1.5 text-outline-variant rounded transition-colors cursor-not-allowed" title="Altı çizili (yakında)" disabled>
                                <span class="material-symbols-outlined text-[18px]">format_underlined</span>
                            </button>
                            <div class="w-px h-4 bg-outline-variant mx-1"></div>
                            <button type="button" class="p-1.5 text-outline-variant rounded transition-colors cursor-not-allowed" title="Madde işareti (yakında)" disabled>
                                <span class="material-symbols-outlined text-[18px]">format_list_bulleted</span>
                            </button>
                            <button type="button" class="p-1.5 text-outline-variant rounded transition-colors cursor-not-allowed" title="Numaralı liste (yakında)" disabled>
                                <span class="material-symbols-outlined text-[18px]">format_list_numbered</span>
                            </button>
                            <div class="w-px h-4 bg-outline-variant mx-1"></div>
                            <button type="button" class="p-1.5 text-outline-variant rounded transition-colors cursor-not-allowed" title="Bağlantı (yakında)" disabled>
                                <span class="material-symbols-outlined text-[18px]">link</span>
                            </button>
                            <button type="button" class="p-1.5 text-outline-variant rounded transition-colors cursor-not-allowed" title="Dosya ekle (yakında)" disabled>
                                <span class="material-symbols-outlined text-[18px]">attach_file</span>
                            </button>
                        </div>
                        <textarea class="flex-1 w-full bg-surface-container-lowest border-none p-4 focus:ring-0 font-body-sm-reg text-body-sm-reg text-on-surface resize-none placeholder:text-outline"
                                  asp-for="Body" placeholder="Mesajınızı yazın..."></textarea>
                    </div>
                    <span asp-validation-for="Body" class="text-error text-body-sm-reg text-xs"></span>
                </div>

            </div>

            <!-- Footer / Actions -->
            <div class="flex items-center justify-between px-6 py-4 border-t border-outline-variant bg-surface-container-lowest shrink-0">
                <div class="flex items-center text-on-surface-variant font-body-sm-reg text-[12px]">
                    @if (Model.ExistingDraftId.HasValue)
                    {
                        <span class="material-symbols-outlined text-[14px] mr-1">edit_note</span>
                        <span>Bir taslak üzerinde düzenleme yapıyorsunuz</span>
                    }
                </div>
                <div class="flex items-center gap-3">
                    <a asp-area="User" asp-controller="Messages" asp-action="Inbox"
                       class="px-4 py-2 font-body-sm-medium text-body-sm-medium text-on-surface-variant hover:text-error hover:bg-error-container rounded transition-colors"
                       onclick="return confirm('Yazdıklarınız kaydedilmeden kaybolacak, emin misiniz?');">
                        Vazgeç
                    </a>
                    <button type="submit" name="submitAction" value="draft"
                            class="px-4 py-2 font-body-sm-medium text-body-sm-medium text-on-surface bg-surface-container-lowest border border-outline-variant hover:bg-surface-container-low rounded transition-colors shadow-sm">
                        Taslak Olarak Kaydet
                    </button>
                    <button type="submit" name="submitAction" value="send"
                            class="px-6 py-2 font-body-sm-medium text-body-sm-medium text-on-primary bg-primary-container hover:bg-primary rounded shadow-sm transition-colors flex items-center gap-2">
                        Gönder
                        <span class="material-symbols-outlined text-[18px]">send</span>
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>
