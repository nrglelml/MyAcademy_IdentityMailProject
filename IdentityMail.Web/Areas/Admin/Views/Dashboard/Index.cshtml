@model UserDto
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="flex-1 overflow-y-auto p-gutter sm:p-container_padding">
    <div class="max-w-7xl mx-auto space-y-6">
        <!-- Page Header -->
        <div class="flex items-center justify-between">
            <h1 class="font-display-sm text-display-sm text-on-surface">İstatistikler</h1>
           
        </div>
        <!-- Stats Grid (6 cards) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Stat 1 -->
            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-on-surface-variant font-body-sm-medium text-body-sm-medium mb-1">Toplam Kullanıcı</p>
                        <h3 class="font-display-sm text-display-sm text-on-surface">@ViewBag.Users</h3>
                    </div>
                    <div class="p-2 bg-primary-fixed-dim/20 rounded-lg text-primary">
                        <span class="material-symbols-outlined">group</span>
                    </div>
                </div>
            </div>
            <!-- Stat 2 -->
            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-on-surface-variant font-body-sm-medium text-body-sm-medium mb-1">Aktif Kullanıcılar</p>
                        <h3 class="font-display-sm text-display-sm text-on-surface"> @ViewBag.ActiveUsers</h3>
                    </div>
                    <div class="p-2 bg-primary-fixed-dim/20 rounded-lg text-primary">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                </div>
                
            </div>
            <!-- Stat 3 -->
            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-on-surface-variant font-body-sm-medium text-body-sm-medium mb-1">Toplam Mesaj Sayısı</p>
                        <h3 class="font-display-sm text-display-sm text-on-surface">@ViewBag.TotalMessages</h3>
                    </div>
                    <div class="p-2 bg-primary-fixed-dim/20 rounded-lg text-primary">
                        <span class="material-symbols-outlined">message</span>
                    </div>
                </div>
              
            </div>
            <!-- Stat 4 -->
            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-on-surface-variant font-body-sm-medium text-body-sm-medium mb-1">Bugün Gönderilen Mesaj Sayısı</p>
                        <h3 class="font-display-sm text-display-sm text-on-surface">@ViewBag.TodayMessages</h3>
                    </div>
                    <div class="p-2 bg-primary-fixed-dim/20 rounded-lg text-primary">
                        <span class="material-symbols-outlined">send</span>
                    </div>
                </div>
               
            </div>
            <!-- Stat 5 -->
            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-on-surface-variant font-body-sm-medium text-body-sm-medium mb-1">Okunmamış Mesajlar</p>
                        <h3 class="font-display-sm text-display-sm text-on-surface">@ViewBag.UnreadMessages</h3>
                    </div>
                    <div class="p-2 bg-primary-fixed-dim/20 rounded-lg text-primary">
                        <span class="material-symbols-outlined">mark_email_unread</span>
                    </div>
                </div>
              
            </div>
            <!-- Stat 6 -->
            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-on-surface-variant font-body-sm-medium text-body-sm-medium mb-1">Çöp Kutusundaki Mesajlar</p>
                        <h3 class="font-display-sm text-display-sm text-on-surface">@ViewBag.TrashMessages </h3>
                    </div>
                    <div class="p-2 bg-primary-fixed-dim/20 rounded-lg text-primary">
                        <span class="material-symbols-outlined">delete</span>
                    </div>
                </div>
               
            </div>
        </div>
        <!-- Panels Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Top Senders Panel -->
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col">
                <div class="p-6 border-b border-outline-variant flex items-center justify-between">
                    <h2 class="font-headline-md text-headline-md text-on-surface">En Çok Mesaj Gönderenler</h2>
                    
                </div>
                <div class="p-0 flex-1">
                    <ul class="divide-y divide-outline-variant">
                        @foreach(var item in Model.TopSenders)
                        {
                            <li class="flex items-center justify-between p-4 hover:bg-surface-container-low transition-colors">
                                <div class="flex items-center gap-3">
                                    <img class="w-10 h-10 rounded-full object-cover border border-outline-variant" src="@item.ImageUrl" />
                                    <div>
                                        <p class="font-body-sm-medium text-body-sm-medium text-on-surface">@item.FirstName @item.LastName</p>
                                        <p class="text-xs text-on-surface-variant">@item.Email</p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="font-body-sm-medium text-body-sm-medium text-on-surface">@item.MessageCount</p>
                                    <p class="text-xs text-on-surface-variant">mesaj</p>
                                </div>
                            </li>
                        }

                    </ul>
                </div>
            </div>
            <!-- Most Used Categories Panel -->
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col">
                <div class="p-6 border-b border-outline-variant flex items-center justify-between">
                    <h2 class="font-headline-md text-headline-md text-on-surface">En Çok Kullanılan Kategoriler</h2> 
                </div>
                <div class="p-6 flex-1 flex flex-col justify-center">
                    <div class="space-y-5">
                     @foreach(var item in Model.TopCategories)
                        {
                            <div>
                                <div class="flex items-center justify-between mb-1">
                                    <div class="flex items-center gap-2">
                                        <span class="w-2.5 h-2.5 " style="background-color: @item.ColorHex"></span>
                                        <span class="font-body-sm-medium text-body-sm-medium text-on-surface">@item.Name</span>
                                    </div>
                                    <span class="text-xs text-on-surface-variant font-medium">@item.MessageCount mesaj</span>
                                </div>
                                <div class="w-full bg-surface-container-low rounded-full h-2 overflow-hidden">
                                    <div class="bg-primary-container h-2 rounded-full" style="width: @item.MessageCount%"></div>
                                </div>
                            </div>
                        }

 
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

