<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>NMail - @ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />

    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "on-primary": "#ffffff",
                      "background": "#f8f9fa",
                      "inverse-surface": "#2e3132",
                      "primary": "#3525cd",
                      "secondary-container": "#6063ee",
                      "surface-container-lowest": "#ffffff",
                      "on-tertiary-fixed": "#351000",
                      "primary-fixed": "#e2dfff",
                      "error-container": "#ffdad6",
                      "on-error": "#ffffff",
                      "surface-container-highest": "#e1e3e4",
                      "tertiary-fixed": "#ffdbcc",
                      "tertiary": "#7e3000",
                      "on-primary-container": "#dad7ff",
                      "on-error-container": "#93000a",
                      "surface-container-high": "#e7e8e9",
                      "on-secondary-fixed": "#07006c",
                      "on-primary-fixed-variant": "#3323cc",
                      "surface-tint": "#4d44e3",
                      "secondary-fixed": "#e1e0ff",
                      "surface": "#f8f9fa",
                      "surface-container-low": "#f3f4f5",
                      "tertiary-container": "#a44100",
                      "on-tertiary-fixed-variant": "#7b2f00",
                      "surface-bright": "#f8f9fa",
                      "on-secondary-fixed-variant": "#2f2ebe",
                      "on-secondary": "#ffffff",
                      "on-surface-variant": "#464555",
                      "primary-container": "#4f46e5",
                      "on-secondary-container": "#fffbff",
                      "on-primary-fixed": "#0f0069",
                      "on-tertiary-container": "#ffd2be",
                      "surface-container": "#edeeef",
                      "surface-dim": "#d9dadb",
                      "outline-variant": "#c7c4d8",
                      "on-tertiary": "#ffffff",
                      "inverse-primary": "#c3c0ff",
                      "on-background": "#191c1d",
                      "error": "#ba1a1a",
                      "outline": "#777587",
                      "primary-fixed-dim": "#c3c0ff",
                      "on-surface": "#191c1d",
                      "surface-variant": "#e1e3e4",
                      "tertiary-fixed-dim": "#ffb695",
                      "secondary": "#4648d4",
                      "inverse-on-surface": "#f0f1f2",
                      "secondary-fixed-dim": "#c0c1ff"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "gutter": "1.5rem",
                      "sidebar_width": "240px",
                      "navbar_height": "64px",
                      "stack_gap_md": "1rem",
                      "container_padding": "2rem",
                      "stack_gap_sm": "0.5rem"
              },
              "fontFamily": {
                      "display-sm": ["Inter"],
                      "body-lg-bold": ["Inter"],
                      "body-sm-medium": ["Inter"],
                      "label-caps": ["Inter"],
                      "headline-md": ["Inter"],
                      "body-lg-reg": ["Inter"],
                      "body-sm-reg": ["Inter"]
              },
              "fontSize": {
                      "display-sm": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.02em", "fontWeight": "600"}],
                      "body-lg-bold": ["16px", {"lineHeight": "24px", "fontWeight": "600"}],
                      "body-sm-medium": ["14px", {"lineHeight": "20px", "fontWeight": "500"}],
                      "label-caps": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700"}],
                      "headline-md": ["18px", {"lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                      "body-lg-reg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                      "body-sm-reg": ["14px", {"lineHeight": "20px", "fontWeight": "400"}]
              }
            }
          }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .icon-fill {
            font-variation-settings: 'FILL' 1;
        }
    </style>
</head>
<body class="bg-background text-on-background font-body-lg-reg h-screen overflow-hidden flex flex-col">

    <!-- Top App Bar (Header) -->
    <header class="flex items-center justify-between px-gutter w-full z-50 fixed top-0 h-navbar_height bg-surface-container-lowest dark:bg-inverse-surface border-b border-outline-variant dark:border-outline shadow-sm">
        <!-- Brand / Mobile Menu -->
        <div class="flex items-center gap-4">
            <button class="md:hidden text-on-surface-variant hover:bg-surface-container-low p-2 rounded-full transition-colors">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <a href="/" class="font-display-sm text-display-sm text-primary dark:text-primary-fixed-dim">NMail</a>
        </div>

        <!-- NavBar Search Component -->
        @await Component.InvokeAsync("_NavBar")

    </header>

    <div class="flex flex-1 pt-navbar_height h-full overflow-hidden">
        <!-- Sidebar Navigation -->
        <nav class="hidden md:flex flex-col py-4 px-2 space-y-stack_gap_sm overflow-y-auto bg-surface-container-lowest dark:bg-inverse-surface w-sidebar_width h-[calc(100vh-64px)] fixed left-0 top-navbar_height border-r border-outline-variant dark:border-outline z-40">
            <!-- New Message CTA -->
            <div class="px-2 mb-4">
                <a asp-area="User" asp-controller="Message" asp-action="Compose" class="w-full flex items-center justify-center gap-2 bg-primary-container text-on-primary-container font-body-sm-medium px-4 py-2.5 rounded-lg hover:opacity-90 transition-opacity shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">edit</span>
                    <span>Yeni Mesaj</span>
                </a>
            </div>

            <!-- Main Nav Items -->
            <div class="space-y-1">
                <a class="flex items-center gap-3 px-3 py-2 bg-secondary-fixed dark:bg-secondary-fixed-dim text-on-secondary-fixed dark:text-on-secondary-fixed-variant rounded-lg font-body-sm-medium group active:scale-95 transition-transform duration-150" asp-area="User" asp-controller="Message" asp-action="Inbox">
                    <span class="material-symbols-outlined icon-fill">inbox</span>
                    <span class="flex-grow">Gelen Kutusu</span>
                    <span class="bg-primary text-on-primary text-[10px] font-bold px-1.5 py-0.5 rounded-full">12</span>
                </a>
                <a class="flex items-center gap-3 px-3 py-2 text-on-surface-variant dark:text-surface-variant hover:bg-surface-container-low dark:hover:bg-surface-container-high rounded-lg font-body-sm-medium transition-colors" asp-area="User" asp-controller="Message" asp-action="Sendbox">
                    <span class="material-symbols-outlined">send</span>
                    <span>Gönderilenler</span>
                </a>
                <a class="flex items-center gap-3 px-3 py-2 text-on-surface-variant dark:text-surface-variant hover:bg-surface-container-low dark:hover:bg-surface-container-high rounded-lg font-body-sm-medium transition-colors" asp-area="User" asp-controller="Draft" asp-action="Index">
                    <span class="material-symbols-outlined">draft</span>
                    <span>Taslaklar</span>
                </a>
                <a class="flex items-center gap-3 px-3 py-2 text-on-surface-variant dark:text-surface-variant hover:bg-surface-container-low dark:hover:bg-surface-container-high rounded-lg font-body-sm-medium transition-colors" asp-area="User" asp-controller="Message" asp-action="Starred">
                    <span class="material-symbols-outlined">star</span>
                    <span>Yıldızlı</span>
                </a>
                <a class="flex items-center gap-3 px-3 py-2 text-on-surface-variant dark:text-surface-variant hover:bg-surface-container-low dark:hover:bg-surface-container-high rounded-lg font-body-sm-medium transition-colors" asp-area="User" asp-controller="Message" asp-action="Trash">
                    <span class="material-symbols-outlined">delete</span>
                    <span>Çöp Kutusu</span>
                </a>
            </div>

            <!-- Categories Section (Akordiyon / Açılır Kapanır) -->
            <div class="mt-6">
                <button onclick="toggleCategories()" class="w-full px-3 mb-2 flex items-center justify-between text-on-surface-variant hover:text-on-surface focus:outline-none">
                    <span class="font-label-caps uppercase text-outline">Kategoriler</span>
                    <span id="categoryArrow" class="material-symbols-outlined text-[16px] transition-transform duration-200">expand_more</span>
                </button>
                <div id="categoryList" class="space-y-1 transition-all duration-300">
                    <a class="flex items-center gap-3 px-3 py-1.5 text-on-surface-variant hover:bg-surface-container-low rounded-lg font-body-sm-reg" href="#">
                        <span class="w-2 h-2 rounded-full bg-secondary-container"></span>
                        <span>İş</span>
                    </a>
                    <a class="flex items-center gap-3 px-3 py-1.5 text-on-surface-variant hover:bg-surface-container-low rounded-lg font-body-sm-reg" href="#">
                        <span class="w-2 h-2 rounded-full bg-tertiary-container"></span>
                        <span>Kişisel</span>
                    </a>
                    <a class="flex items-center gap-3 px-3 py-1.5 text-on-surface-variant hover:bg-surface-container-low rounded-lg font-body-sm-reg" href="#">
                        <span class="w-2 h-2 rounded-full bg-error"></span>
                        <span>Sosyal</span>
                    </a>
                </div>
            </div>

            <div class="mt-auto pt-4 border-t border-outline-variant/50">
                <div class="space-y-1">
                    <a class="flex items-center gap-3 px-3 py-2 text-on-surface-variant dark:text-surface-variant hover:bg-surface-container-low dark:hover:bg-surface-container-high rounded-lg font-body-sm-medium transition-colors" asp-controller="Settings" asp-action="Profile" asp-area="User">
                        <span class="material-symbols-outlined">settings</span>
                        <span>Ayarlar</span>
                    </a>
                    <a class="flex items-center gap-3 px-3 py-2 text-on-surface-variant dark:text-surface-variant hover:bg-surface-container-low dark:hover:bg-surface-container-high rounded-lg font-body-sm-medium transition-colors" href="#">
                        <span class="material-symbols-outlined">archive</span>
                        <span>Arşiv</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Dynamic View Content Container -->
        <div class="flex-1 overflow-y-auto h-[calc(100vh-64px)] md:ml-sidebar_width w-full">
            @RenderBody()
        </div>
    </div>

    <!-- JavaScript İşlevleri -->
    <script>
        // Profil Menüsünü Aç / Kapat
        function toggleProfileMenu() {
            const dropdown = document.getElementById('profileDropdown');
            dropdown.classList.toggle('hidden');
        }

        // Kategoriler Listesini Aç / Kapat (Akordiyon)
        function toggleCategories() {
            const list = document.getElementById('categoryList');
            const arrow = document.getElementById('categoryArrow');
            list.classList.toggle('hidden');
            arrow.classList.toggle('rotate-180');
        }

        // Menü Dışına Tıklayınca Profil Menüsünü Kapat
        window.addEventListener('click', function(e) {
            const dropdown = document.getElementById('profileDropdown');
            const button = dropdown.previousElementSibling;
            if (!dropdown.contains(e.target) && !button.contains(e.target)) {
                dropdown.classList.add('hidden');
            }
        });
    </script>
</body>
</html>