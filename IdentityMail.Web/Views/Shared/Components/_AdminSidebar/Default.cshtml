@*
    Admin Sidebar Component
*@
<nav class="hidden md:flex flex-col py-4 px-2 space-y-stack_gap_sm overflow-y-auto bg-surface-container-lowest dark:bg-inverse-surface w-sidebar_width h-[calc(100vh-64px)] fixed left-0 top-navbar_height border-r border-outline-variant dark:border-outline z-40">
    <!-- Main Nav Items -->
    <div class="space-y-1">
        <a class="flex items-center gap-3 px-3 py-2 bg-secondary-fixed dark:bg-secondary-fixed-dim text-on-secondary-fixed dark:text-on-secondary-fixed-variant rounded-lg font-body-sm-medium group active:scale-95 transition-transform duration-150" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <span class="material-symbols-outlined icon-fill">dashboard</span>
            <span class="flex-grow">Dashboard</span>
            
        </a>
        <a class="flex items-center gap-3 px-3 py-2 text-on-surface-variant dark:text-surface-variant hover:bg-surface-container-low dark:hover:bg-surface-container-high rounded-lg font-body-sm-medium transition-colors" asp-area="Admin" asp-controller="Users" asp-action="Index">
            <span class="material-symbols-outlined">group</span>
            <span>Kullanıcı Listesi</span>
          
        </a>
        
        <a class="flex items-center gap-3 px-3 py-2 text-on-surface-variant dark:text-surface-variant hover:bg-surface-container-low dark:hover:bg-surface-container-high rounded-lg font-body-sm-medium transition-colors" asp-area="Admin" asp-controller="Category" asp-action="Index">
            <span class="material-symbols-outlined">edit</span>
            <span>Kategoriler</span>

        </a>

        <a class="flex items-center gap-3 px-3 py-2 text-on-surface-variant dark:text-surface-variant hover:bg-surface-container-low dark:hover:bg-surface-container-high rounded-lg font-body-sm-medium transition-colors" asp-area="" asp-controller="" asp-action="">
            <span class="material-symbols-outlined">report</span>
            <span>Şikayet Edilen Mesajlar</span>
         @*    <span class="bg-primary text-on-primary text-[10px] font-bold px-1.5 py-0.5 rounded-full">@ViewBag.TrashCount</span> *@
        </a>
        
    </div>



</nav>

