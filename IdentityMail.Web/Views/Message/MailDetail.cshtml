@model UserMessage
@{
    ViewData["Title"] = "MailDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Gelen Mail İçeriği </h1>

<table class="table table-striped">
    <tr>
        <th>Gönderen Ad Soyad: </th>
        <td>@Model.Sender.FirstName @Model.Sender.LastName</td>
    </tr>
    <tr>
        <th>Gönderen Email:</th>
        <td>@Model.Sender.Email</td>
    </tr>
    <tr>
        <th>Konu</th>
        <td>@Model.Subject</td>
    </tr>
    <tr>
        <th>Tarih</th>
        <td>@Model.SendDate</td>
    </tr>
    <tr>
        <th>Mail İçeriği</th>
        <td>@Model.Body</td>
    </tr>
</table>