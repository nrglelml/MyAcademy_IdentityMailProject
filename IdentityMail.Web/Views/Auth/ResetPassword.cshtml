@model ResetPasswordDto

@{
    Layout = null; 
    ViewData["Title"] = "Şifreyi Sıfırla";
}

<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>NMail - @ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "background": "#f8f9fa",
                        "on-secondary-fixed-variant": "#2f2ebe",
                        "on-primary-fixed-variant": "#3323cc",
                        "on-primary-container": "#dad7ff",
                        "secondary-fixed-dim": "#c0c1ff",
                        "outline-variant": "#c7c4d8",
                        "inverse-surface": "#2e3132",
                        "primary": "#3525cd",
                        "error": "#ba1a1a",
                        "primary-fixed": "#e2dfff",
                        "surface-dim": "#d9dadb",
                        "surface-container-high": "#e7e8e9",
                        "inverse-on-surface": "#f0f1f2",
                        "surface-container": "#edeeef",
                        "surface-container-low": "#f3f4f5",
                        "tertiary": "#7e3000",
                        "on-tertiary": "#ffffff",
                        "surface-variant": "#e1e3e4",
                        "on-secondary": "#ffffff",
                        "surface": "#f8f9fa",
                        "on-primary": "#ffffff",
                        "on-tertiary-container": "#ffd2be",
                        "secondary": "#4648d4",
                        "on-background": "#191c1d",
                        "inverse-primary": "#c3c0ff",
                        "surface-bright": "#f8f9fa",
                        "on-error-container": "#93000a",
                        "secondary-fixed": "#e1e0ff",
                        "error-container": "#ffdad6",
                        "on-secondary-fixed": "#07006c",
                        "on-error": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "secondary-container": "#6063ee",
                        "primary-fixed-dim": "#c3c0ff",
                        "surface-tint": "#4d44e3",
                        "on-primary-fixed": "#0f0069",
                        "surface-container-highest": "#e1e3e4",
                        "outline": "#777587",
                        "on-surface-variant": "#464555",
                        "on-tertiary-fixed-variant": "#7b2f00",
                        "tertiary-container": "#a44100",
                        "primary-container": "#4f46e5",
                        "on-secondary-container": "#fffbff",
                        "on-tertiary-fixed": "#351000",
                        "tertiary-fixed": "#ffdbcc",
                        "on-surface": "#191c1d",
                        "tertiary-fixed-dim": "#ffb695"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "sidebar_width": "240px",
                        "gutter": "1.5rem",
                        "stack_gap_sm": "0.5rem",
                        "container_padding": "2rem",
                        "navbar_height": "64px",
                        "stack_gap_md": "1rem"
                    },
                    "fontFamily": {
                        "body-sm-reg": ["Inter"],
                        "body-lg-bold": ["Inter"],
                        "label-caps": ["Inter"],
                        "display-sm": ["Inter"],
                        "body-lg-reg": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-sm-medium": ["Inter"]
                    },
                    "fontSize": {
                        "body-sm-reg": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "body-lg-bold": ["16px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "label-caps": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700" }],
                        "display-sm": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "body-lg-reg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-md": ["18px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-sm-medium": ["14px", { "lineHeight": "20px", "fontWeight": "500" }]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-background min-h-screen flex flex-col items-center justify-center p-4">
    <!-- Brand Logo -->
    <div class="mb-8 text-center">
        <span class="font-display-sm text-display-sm font-bold text-primary">NMail</span>
    </div>

    <!-- Reset Password Card -->
    <div class="bg-surface-container-lowest w-full max-w-md rounded-xl p-8 border border-surface-variant shadow-[0px_1px_3px_rgba(0,0,0,0.05),0px_1px_2px_rgba(0,0,0,0.03)]">
        <!-- Header -->
        <div class="mb-8 text-center">
            <h1 class="font-headline-md text-headline-md text-on-surface mb-2">Yeni Şifre Oluştur</h1>
            <p class="font-body-sm-reg text-body-sm-reg text-on-surface-variant">Lütfen hesabınız için yeni bir şifre belirleyin.</p>
        </div>

        <!-- Hata Bildirimi Özeti -->
        <div asp-validation-summary="All" class="mb-6 text-body-sm-reg text-error bg-error-container/40 border border-error/20 rounded p-3 text-sm empty:hidden space-y-1"></div>

        <!-- Form -->
        <form class="space-y-6" asp-action="ResetPassword" asp-controller="Auth" method="POST">

            <!-- Gizli Parametreler -->
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <!-- New Password Field -->
            <div>
                <label class="block font-body-sm-medium text-body-sm-medium text-on-surface mb-1" asp-for="NewPassword">Yeni Şifre</label>
                <div class="relative">
                    <input class="w-full bg-surface-container-low border border-outline-variant/40 focus:border-primary focus:bg-surface-container-lowest rounded-lg px-4 py-2 font-body-sm-reg text-body-sm-reg text-on-surface outline-none transition-colors" asp-for="NewPassword" id="new_password" type="password" placeholder="••••••••" />
                    <button class="absolute inset-y-0 right-0 pr-3 flex items-center text-on-surface-variant hover:text-on-surface focus:outline-none" type="button" onclick="togglePasswordVisibility('new_password', this)">
                        <span class="material-symbols-outlined text-[20px]">visibility_off</span>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="mt-1 block text-body-sm-reg text-error text-xs"></span>
            </div>

            <!-- Confirm New Password Field -->
            <div>
                <label class="block font-body-sm-medium text-body-sm-medium text-on-surface mb-1" asp-for="ConfirmPassword">Yeni Şifre Tekrarı</label>
                <div class="relative">
                    <input class="w-full bg-surface-container-low border border-outline-variant/40 focus:border-primary focus:bg-surface-container-lowest rounded-lg px-4 py-2 font-body-sm-reg text-body-sm-reg text-on-surface outline-none transition-colors" asp-for="ConfirmPassword" id="confirm_password" type="password" placeholder="••••••••" />
                    <button class="absolute inset-y-0 right-0 pr-3 flex items-center text-on-surface-variant hover:text-on-surface focus:outline-none" type="button" onclick="togglePasswordVisibility('confirm_password', this)">
                        <span class="material-symbols-outlined text-[20px]">visibility_off</span>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="mt-1 block text-body-sm-reg text-error text-xs"></span>
            </div>

            <!-- Password Requirements Checklist -->
            <div class="space-y-2 mt-4 text-xs">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-outline text-[16px]">info</span>
                    <span class="font-body-sm-reg text-body-sm-reg text-on-surface-variant">Şifreniz en az 6 karakter uzunluğunda olmalıdır.</span>
                </div>
            </div>

            <!-- Submit Button -->
            <button class="w-full bg-primary-container hover:bg-primary text-on-primary font-body-lg-bold text-body-lg-bold py-2.5 px-4 rounded-lg transition-colors mt-6" type="submit">
                Şifreyi Güncelle
            </button>
        </form>

        <div class="mt-6 text-center">
            <a class="font-body-sm-medium text-body-sm-medium text-primary hover:text-primary-container transition-colors inline-flex items-center gap-1" href="@Url.Action("Login", "Auth")">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                Giriş sayfasına dön
            </a>
        </div>
    </div>

    <!-- Şifre Göster/Gizle Scripti -->
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('.material-symbols-outlined');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility_off';
            }
        }
    </script>
</body>
</html>