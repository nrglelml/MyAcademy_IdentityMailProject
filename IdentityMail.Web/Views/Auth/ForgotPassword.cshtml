@{
    Layout = null; 
    ViewData["Title"] = "Şifremi Unuttum";
}

<!DOCTYPE html>
<html class="h-full bg-surface" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>NMail - @ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-bright": "#f8f9fa",
                        "outline-variant": "#c7c4d8",
                        "surface-dim": "#d9dadb",
                        "on-surface-variant": "#464555",
                        "on-background": "#191c1d",
                        "surface-container": "#edeeef",
                        "secondary-container": "#6063ee",
                        "background": "#f8f9fa",
                        "error-container": "#ffdad6",
                        "secondary-fixed-dim": "#c0c1ff",
                        "surface-variant": "#e1e3e4",
                        "primary-container": "#4f46e5",
                        "on-tertiary-fixed-variant": "#7b2f00",
                        "on-secondary-fixed": "#07006c",
                        "error": "#ba1a1a",
                        "on-secondary-fixed-variant": "#2f2ebe",
                        "secondary": "#4648d4",
                        "on-primary-container": "#dad7ff",
                        "inverse-primary": "#c3c0ff",
                        "on-primary-fixed": "#0f0069",
                        "on-tertiary": "#ffffff",
                        "on-tertiary-fixed": "#351000",
                        "surface-container-low": "#f3f4f5",
                        "on-error-container": "#93000a",
                        "surface-container-lowest": "#ffffff",
                        "surface-tint": "#4d44e3",
                        "on-primary": "#ffffff",
                        "on-primary-fixed-variant": "#3323cc",
                        "primary": "#3525cd",
                        "on-secondary": "#ffffff",
                        "surface-container-high": "#e7e8e9",
                        "inverse-on-surface": "#f0f1f2",
                        "surface": "#f8f9fa",
                        "on-error": "#ffffff",
                        "inverse-surface": "#2e3132",
                        "on-surface": "#191c1d",
                        "on-tertiary-container": "#ffd2be",
                        "surface-container-highest": "#e1e3e4",
                        "secondary-fixed": "#e1e0ff",
                        "tertiary-fixed-dim": "#ffb695",
                        "tertiary-fixed": "#ffdbcc",
                        "tertiary": "#7e3000",
                        "primary-fixed": "#e2dfff",
                        "tertiary-container": "#a44100",
                        "outline": "#777587",
                        "on-secondary-container": "#fffbff",
                        "primary-fixed-dim": "#c3c0ff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "container_padding": "2rem",
                        "navbar_height": "64px",
                        "stack_gap_md": "1rem",
                        "gutter": "1.5rem",
                        "stack_gap_sm": "0.5rem",
                        "sidebar_width": "240px"
                    },
                    "fontFamily": {
                        "body-lg-reg": ["Inter"],
                        "body-sm-reg": ["Inter"],
                        "display-sm": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-sm-medium": ["Inter"],
                        "body-lg-bold": ["Inter"],
                        "label-caps": ["Inter"]
                    },
                    "fontSize": {
                        "body-lg-reg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "body-sm-reg": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "display-sm": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "headline-md": ["18px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-sm-medium": ["14px", { "lineHeight": "20px", "fontWeight": "500" }],
                        "body-lg-bold": ["16px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "label-caps": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700" }]
                    }
                }
            }
        }
    </script>
</head>
<body class="h-full flex items-center justify-center p-4">
    <div class="w-full max-w-md space-y-8">

        <!-- Logo -->
        <div class="text-center">
            <h1 class="font-display-sm text-display-sm text-primary">NMail</h1>
        </div>

        @if (ViewBag.Message != null)
        {
            <!-- Başarılı Gönderim Kartı (Backend'den mesaj gelirse görüntülenir) -->
            <div class="bg-surface-container-lowest rounded-xl p-8 border border-outline-variant shadow-[0px_1px_3px_rgba(0,0,0,0.05),0px_1px_2px_rgba(0,0,0,0.03)] text-center transition-all duration-300">
                <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-green-100 mb-4">
                    <span class="material-symbols-outlined text-green-600 text-3xl" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                </div>
                <h2 class="font-headline-md text-headline-md text-on-surface mb-2">E-postanızı Kontrol Edin</h2>
                <p class="font-body-sm-reg text-body-sm-reg text-on-surface-variant mb-6">
                    @ViewBag.Message
                </p>
                <div>
                    <a class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm font-body-sm-medium text-body-sm-medium text-on-primary bg-primary-container hover:bg-primary transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary" href="@Url.Action("Login", "Auth")">
                        Giriş Sayfasına Dön
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Şifre Sıfırlama İstek Kartı -->
            <div class="bg-surface-container-lowest rounded-xl p-8 border border-outline-variant shadow-[0px_1px_3px_rgba(0,0,0,0.05),0px_1px_2px_rgba(0,0,0,0.03)] transition-all duration-300">
                <h2 class="font-headline-md text-headline-md text-on-surface mb-2">Şifrenizi mi Unuttunuz?</h2>
                <p class="font-body-sm-reg text-body-sm-reg text-on-surface-variant mb-6">
                    E-posta adresinizi girin, size şifre sıfırlama bağlantısı gönderelim.
                </p>

                <!-- Hata Mesajı Özeti -->
                <div asp-validation-summary="All" class="mb-4 text-body-sm-reg text-error bg-error-container/40 border border-error/20 rounded p-3 text-sm empty:hidden space-y-1"></div>

                <form class="space-y-6" asp-action="ForgotPassword" asp-controller="Auth" method="POST">
                    <div>
                        <label class="block font-body-sm-medium text-body-sm-medium text-on-surface mb-1.5" for="email">E-posta Adresi</label>
                        <input autocomplete="email" class="appearance-none block w-full px-3 py-2 border border-outline-variant/50 rounded-md shadow-sm placeholder-outline/60 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary font-body-sm-reg text-body-sm-reg text-on-surface bg-surface-container-low focus:bg-surface-container-lowest transition-colors" id="email" name="email" placeholder="ornek@mail.com" required type="email" />
                    </div>
                    <div>
                        <button class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm font-body-sm-medium text-body-sm-medium text-on-primary bg-primary-container hover:bg-primary transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary" type="submit">
                            Sıfırlama Bağlantısı Gönder
                        </button>
                    </div>
                </form>

                <div class="mt-6 text-center">
                    <a class="font-body-sm-medium text-body-sm-medium text-primary hover:text-primary-container transition-colors inline-flex items-center gap-1" href="@Url.Action("Login", "Auth")">
                        <span class="material-symbols-outlined text-sm">arrow_back</span>
                        Giriş sayfasına dön
                    </a>
                </div>
            </div>
        }

    </div>
</body>
</html>