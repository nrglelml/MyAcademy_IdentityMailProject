@model LoginDto
@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #12131c;
            --surface: #1a1c28;
            --surface-2: #21232f;
            --text: #eef0f6;
            --muted: #9497ab;
            --accent: #f2b84b;
            --accent-dark: #d99a2b;
            --danger: #ff7a7a;
            --border: rgba(255, 255, 255, 0.09);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        .layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            min-height: 100vh;
        }

        /* ---------- Left panel ---------- */
        .brand-panel {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 64px;
            overflow: hidden;
            background: radial-gradient(circle at 30% 30%, rgba(242, 184, 75, 0.10), transparent 60%), #0e0f16;
            border-right: 1px solid var(--border);
        }

        .rings {
            position: absolute;
            top: 50%;
            left: 12%;
            width: 420px;
            height: 420px;
            transform: translateY(-50%);
            pointer-events: none;
        }

            .rings span {
                position: absolute;
                inset: 0;
                border-radius: 50%;
                border: 1px solid rgba(242, 184, 75, 0.35);
                animation: pulse 4.5s ease-out infinite;
                opacity: 0;
            }

                .rings span:nth-child(1) {
                    animation-delay: 0s;
                }

                .rings span:nth-child(2) {
                    animation-delay: 1.5s;
                }

                .rings span:nth-child(3) {
                    animation-delay: 3s;
                }

        @@keyframes pulse {
            0% {
                transform: scale(0.35);
                opacity: 0;
            }

            15% {
                opacity: 0.9;
            }

            100% {
                transform: scale(1);
                opacity: 0;
            }
        }

        .brand-content {
            position: relative;
            z-index: 1;
            max-width: 420px;
        }

        .brand-eyebrow {
            display: inline-block;
            font-size: 13px;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 22px;
        }

        .brand-title {
            font-family: 'Fraunces', serif;
            font-weight: 500;
            font-size: 46px;
            line-height: 1.12;
            margin: 0 0 20px;
        }

        .brand-sub {
            color: var(--muted);
            font-size: 15.5px;
            line-height: 1.6;
            margin: 0;
        }

        /* ---------- Right panel (form) ---------- */
        .form-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 32px;
        }

        .card {
            width: 100%;
            max-width: 420px;
        }

            .card h1 {
                font-family: 'Fraunces', serif;
                font-weight: 500;
                font-size: 28px;
                margin: 0 0 6px;
            }

            .card p.lead {
                color: var(--muted);
                font-size: 14.5px;
                margin: 0 0 32px;
            }

        .field {
            margin-bottom: 18px;
            position: relative;
        }

            .field label {
                display: block;
                font-size: 13px;
                font-weight: 500;
                color: var(--muted);
                margin-bottom: 7px;
            }

        .field-top {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
        }

        .forgot-link {
            font-size: 12.5px;
            color: var(--accent);
            text-decoration: none;
        }

            .forgot-link:hover {
                text-decoration: underline;
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap svg {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                width: 17px;
                height: 17px;
                stroke: var(--muted);
                pointer-events: none;
            }

            .input-wrap input {
                width: 100%;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 12px 14px 12px 40px;
                font-size: 14.5px;
                color: var(--text);
                font-family: 'Inter', sans-serif;
                transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
            }

                .input-wrap input::placeholder {
                    color: #5c5f70;
                }

                .input-wrap input:focus {
                    outline: none;
                    border-color: var(--accent);
                    background: var(--surface-2);
                    box-shadow: 0 0 0 3px rgba(242, 184, 75, 0.16);
                }

                .input-wrap input.input-validation-error {
                    border-color: var(--danger);
                }

            .input-wrap:has(.toggle-pw) input {
                padding-right: 42px;
            }

        .toggle-pw {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            display: flex;
            color: var(--muted);
        }

            .toggle-pw:hover {
                color: var(--text);
            }

            .toggle-pw svg {
                width: 17px;
                height: 17px;
                stroke: currentColor;
            }

        span.field-validation-error {
            display: block;
            color: var(--danger);
            font-size: 12.5px;
            margin-top: 6px;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

        .validation-summary-errors {
            display: none;
        }

            .validation-summary-errors:has(li) {
                display: block;
                background: rgba(255, 122, 122, 0.08);
                border: 1px solid rgba(255, 122, 122, 0.3);
                border-left: 3px solid var(--danger);
                color: #ffb3b3;
                font-size: 13px;
                border-radius: 8px;
                padding: 12px 16px;
                margin-bottom: 18px;
            }

        .remember {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13.5px;
            color: var(--muted);
            margin: -4px 0 22px;
        }

            .remember input[type="checkbox"] {
                appearance: none;
                width: 16px;
                height: 16px;
                border: 1px solid var(--border);
                border-radius: 4px;
                background: var(--surface);
                cursor: pointer;
                position: relative;
                flex: none;
            }

                .remember input[type="checkbox"]:checked {
                    background: var(--accent);
                    border-color: var(--accent);
                }

                    .remember input[type="checkbox"]:checked::after {
                        content: "";
                        position: absolute;
                        left: 5px;
                        top: 1px;
                        width: 4px;
                        height: 8px;
                        border: solid #1a1206;
                        border-width: 0 2px 2px 0;
                        transform: rotate(45deg);
                    }

        button.submit {
            width: 100%;
            border: none;
            border-radius: 10px;
            padding: 13px;
            font-size: 15px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            color: #1a1206;
            background: linear-gradient(180deg, var(--accent), var(--accent-dark));
            cursor: pointer;
            margin-top: 6px;
            transition: transform .12s ease, box-shadow .12s ease;
        }

            button.submit:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(242, 184, 75, 0.25);
            }

            button.submit:active {
                transform: translateY(0);
            }

        .switch {
            text-align: center;
            font-size: 13.5px;
            color: var(--muted);
            margin-top: 24px;
        }

            .switch a {
                color: var(--accent);
                text-decoration: none;
                font-weight: 500;
            }

                .switch a:hover {
                    text-decoration: underline;
                }

        a:focus-visible, button:focus-visible, input:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        @@media (max-width: 880px) {
            .layout {
                grid-template-columns: 1fr;
            }

            .brand-panel {
                display: none;
            }

            .form-panel {
                padding: 40px 20px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .rings span {
                animation: none;
                opacity: 0.4;
            }
        }
    </style>
</head>
<body>
    <div class="layout">
        <div class="brand-panel">
            <div class="rings" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>
            <div class="brand-content">
                <span class="brand-eyebrow">Tekrar hoş geldin</span>
                <h2 class="brand-title">Kaldığın<br />yerden devam et.</h2>
                <p class="brand-sub">Hesabına giriş yap ve her şey kaldığın yerde seni bekliyor olsun.</p>
            </div>
        </div>

        <div class="form-panel">
            <div class="card">
                <h1>Giriş Yap</h1>
                <p class="lead">Devam etmek için bilgilerini gir.</p>

                <form method="post">
                    <div asp-validation-summary="All" class="validation-summary-errors"></div>

                    <div class="field">
                        <label>Mail</label>
                        <div class="input-wrap">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
                            <input type="email" asp-for="Email" placeholder="ornek@mail.com" required autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email"></span>
                    </div>

                    <div class="field">
                        <div class="field-top">
                            <label>Şifre</label>
                            <a href="#" class="forgot-link">Şifreni mi unuttun?</a>
                        </div>
                        <div class="input-wrap">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            <input type="password" asp-for="Password" placeholder="••••••••" required autocomplete="current-password" />
                            @* <button type="button" class="toggle-pw" aria-label="Şifreyi göster">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button> *@
                        </div>
                        <span asp-validation-for="Password"></span>
                    </div>

                    <label class="remember">
                        <input type="checkbox" name="rememberMe" />
                        Beni hatırla
                    </label>

                    <button type="submit" class="submit">Giriş Yap</button>

                    <p class="switch">Hesabın yok mu? <a asp-controller="Account" asp-action="Register">Kayıt ol</a></p>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('.toggle-pw').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.closest('.input-wrap').querySelector('input');
                var isPw = input.type === 'password';
                input.type = isPw ? 'text' : 'password';
                btn.setAttribute('aria-label', isPw ? 'Şifreyi gizle' : 'Şifreyi göster');
            });
        });
    </script>
</body>
</html>
