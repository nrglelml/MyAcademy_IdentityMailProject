@model LoginDto
@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
}


<!DOCTYPE html>

<html class="h-full bg-background" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>NMail - @ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
          tailwind.config = {
            darkMode: "class",
            theme: {
              extend: {
                "colors": {
                        "background": "#f8f9fa",
                        "tertiary-fixed-dim": "#ffb695",
                        "on-error": "#ffffff",
                        "tertiary-container": "#a44100",
                        "on-tertiary-container": "#ffd2be",
                        "surface-container-low": "#f3f4f5",
                        "tertiary": "#7e3000",
                        "on-error-container": "#93000a",
                        "primary-container": "#4f46e5",
                        "surface-bright": "#f8f9fa",
                        "secondary": "#4648d4",
                        "on-secondary-fixed-variant": "#2f2ebe",
                        "on-background": "#191c1d",
                        "error-container": "#ffdad6",
                        "surface-variant": "#e1e3e4",
                        "on-secondary": "#ffffff",
                        "outline-variant": "#c7c4d8",
                        "surface-container-high": "#e7e8e9",
                        "secondary-container": "#6063ee",
                        "secondary-fixed": "#e1e0ff",
                        "surface-container-highest": "#e1e3e4",
                        "surface-tint": "#4d44e3",
                        "error": "#ba1a1a",
                        "on-surface-variant": "#464555",
                        "inverse-surface": "#2e3132",
                        "primary": "#3525cd",
                        "on-tertiary": "#ffffff",
                        "surface": "#f8f9fa",
                        "tertiary-fixed": "#ffdbcc",
                        "on-primary-fixed": "#0f0069",
                        "on-tertiary-fixed-variant": "#7b2f00",
                        "on-primary-fixed-variant": "#3323cc",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#edeeef",
                        "primary-fixed-dim": "#c3c0ff",
                        "primary-fixed": "#e2dfff",
                        "on-primary-container": "#dad7ff",
                        "on-surface": "#191c1d",
                        "surface-dim": "#d9dadb",
                        "on-primary": "#ffffff",
                        "on-secondary-fixed": "#07006c",
                        "secondary-fixed-dim": "#c0c1ff",
                        "inverse-primary": "#c3c0ff",
                        "inverse-on-surface": "#f0f1f2",
                        "outline": "#777587",
                        "on-secondary-container": "#fffbff",
                        "on-tertiary-fixed": "#351000"
                },
                "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                },
                "spacing": {
                        "navbar_height": "64px",
                        "stack_gap_md": "1rem",
                        "stack_gap_sm": "0.5rem",
                        "gutter": "1.5rem",
                        "container_padding": "2rem",
                        "sidebar_width": "240px"
                },
                "fontFamily": {
                        "display-sm": [
                                "Inter"
                        ],
                        "body-lg-reg": [
                                "Inter"
                        ],
                        "body-sm-reg": [
                                "Inter"
                        ],
                        "headline-md": [
                                "Inter"
                        ],
                        "body-lg-bold": [
                                "Inter"
                        ],
                        "body-sm-medium": [
                                "Inter"
                        ],
                        "label-caps": [
                                "Inter"
                        ]
                },
                "fontSize": {
                        "display-sm": [
                                "24px",
                                {
                                        "lineHeight": "32px",
                                        "letterSpacing": "-0.02em",
                                        "fontWeight": "600"
                                }
                        ],
                        "body-lg-reg": [
                                "16px",
                                {
                                        "lineHeight": "24px",
                                        "fontWeight": "400"
                                }
                        ],
                        "body-sm-reg": [
                                "14px",
                                {
                                        "lineHeight": "20px",
                                        "fontWeight": "400"
                                }
                        ],
                        "headline-md": [
                                "18px",
                                {
                                        "lineHeight": "28px",
                                        "letterSpacing": "-0.01em",
                                        "fontWeight": "600"
                                }
                        ],
                        "body-lg-bold": [
                                "16px",
                                {
                                        "lineHeight": "24px",
                                        "fontWeight": "600"
                                }
                        ],
                        "body-sm-medium": [
                                "14px",
                                {
                                        "lineHeight": "20px",
                                        "fontWeight": "500"
                                }
                        ],
                        "label-caps": [
                                "12px",
                                {
                                        "lineHeight": "16px",
                                        "letterSpacing": "0.05em",
                                        "fontWeight": "700"
                                }
                        ]
                }
        },
            },
          }
    </script>
</head>
<body class="h-full flex flex-col justify-center py-12 sm:px-6 lg:px-8 bg-background">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <!-- Logo -->
        <h2 class="mt-6 text-center font-display-sm text-display-sm text-primary">
            NMail
        </h2>
        <p class="mt-2 text-center font-body-sm-reg text-body-sm-reg text-on-surface-variant">
            Giriş Yap
        </p>
    </div>
    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-[480px]">
        <div class="bg-surface-container-lowest py-8 px-4 shadow-[0px_1px_3px_rgba(0,0,0,0.05),0px_1px_2px_rgba(0,0,0,0.03)] sm:rounded-xl sm:px-10 border border-surface-variant" >
            <!-- Error Banner -->
            <div class="mb-6 rounded-lg bg-error-container p-4" asp-validation-summary="All">
               
            </div>
            <form  class="space-y-6" method="POST">
                @Html.AntiForgeryToken()
                <div>
                    <label class="block font-body-sm-medium text-body-sm-medium text-on-surface" for="email">Mail Adresi</label>
                    <div class="mt-2">
                        <input autocomplete="email" class="block w-full rounded-lg border-0 py-2 text-on-surface shadow-sm ring-1 ring-inset ring-outline-variant placeholder:text-on-surface-variant focus:ring-2 focus:ring-inset focus:ring-primary-container sm:text-body-sm-reg sm:leading-6 bg-surface-container-low transition-colors duration-200" asp-for="Email" type="email" />
                        <span asp-validation-for="Email" class="mt-1 block text-body-sm-reg text-error text-xs"></span>
                    </div>
                </div>
                <div>
                    <label class="block font-body-sm-medium text-body-sm-medium text-on-surface" for="password">Şifre</label>
                    <div class="mt-2">
                        <input autocomplete="current-password" class="block w-full rounded-lg border-0 py-2 text-on-surface shadow-sm ring-1 ring-inset ring-outline-variant placeholder:text-on-surface-variant focus:ring-2 focus:ring-inset focus:ring-primary-container sm:text-body-sm-reg sm:leading-6 bg-surface-container-low transition-colors duration-200" asp-for="Password" type="password" />
                        <span asp-validation-for="Password" class="mt-1 block text-body-sm-reg text-error text-xs"></span>
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <input class="h-4 w-4 rounded border-outline-variant text-primary-container focus:ring-primary-container bg-surface-container-lowest" id="remember-me" name="remember-me" type="checkbox" />
                        <label class="ml-3 block font-body-sm-reg text-body-sm-reg text-on-surface-variant" for="remember-me">Beni Hatırla</label>
                    </div>
                    <div class="font-body-sm-medium text-body-sm-medium">
                        <a class="text-primary-container hover:text-primary transition-colors duration-200" href="/Auth/ForgotPassword">Şifremi Unuttum?</a>
                    </div>
                </div>
                <div>
                    <button class="flex w-full justify-center rounded-lg bg-primary-container px-3 py-2 font-body-sm-medium text-body-sm-medium text-on-primary shadow-sm hover:bg-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container transition-colors duration-200" type="submit">Giriş Yap</button>
                </div>
            </form>
            <p class="mt-8 text-center font-body-sm-reg text-body-sm-reg text-on-surface-variant">
                Hesabın Yok Mu?
                <a class="font-body-sm-medium text-body-sm-medium text-primary-container hover:text-primary transition-colors duration-200" href="/Auth/Register">Kayıt Ol</a>
            </p>
            <p class="mt-8 text-center font-body-sm-reg text-body-sm-reg text-on-surface-variant">
                Mail Doğrulama Kodu Almadın Mı?
                <a class="font-body-sm-medium text-body-sm-medium text-primary-container hover:text-primary transition-colors duration-200" href="/Auth/ResendEmail">Tekrar Gönder</a>
            </p>
        </div>
    </div>
</body>
</html>
