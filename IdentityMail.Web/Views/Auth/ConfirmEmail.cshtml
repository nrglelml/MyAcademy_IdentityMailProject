@{
    Layout = null; 
    ViewData["Title"] = "E-posta Doğrulama";
}

<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>NMail - @ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#3525cd",
                        "on-tertiary-container": "#ffd2be",
                        "on-secondary-container": "#fffbff",
                        "surface-container": "#edeeef",
                        "error": "#ba1a1a",
                        "on-error": "#ffffff",
                        "secondary-fixed-dim": "#c0c1ff",
                        "on-surface-variant": "#464555",
                        "secondary-fixed": "#e1e0ff",
                        "tertiary": "#7e3000",
                        "on-tertiary": "#ffffff",
                        "primary-container": "#4f46e5",
                        "surface-tint": "#4d44e3",
                        "surface-dim": "#d9dadb",
                        "background": "#f8f9fa",
                        "inverse-on-surface": "#f0f1f2",
                        "primary-fixed": "#e2dfff",
                        "inverse-surface": "#2e3132",
                        "tertiary-fixed-dim": "#ffb695",
                        "on-primary": "#ffffff",
                        "error-container": "#ffdad6",
                        "tertiary-fixed": "#ffdbcc",
                        "primary-fixed-dim": "#c3c0ff",
                        "surface": "#f8f9fa",
                        "on-tertiary-fixed": "#351000",
                        "on-secondary": "#ffffff",
                        "secondary": "#4648d4",
                        "inverse-primary": "#c3c0ff",
                        "on-primary-fixed": "#0f0069",
                        "surface-variant": "#e1e3e4",
                        "on-primary-fixed-variant": "#3323cc",
                        "on-surface": "#191c1d",
                        "on-background": "#191c1d",
                        "surface-container-highest": "#e1e3e4",
                        "on-secondary-fixed-variant": "#2f2ebe",
                        "secondary-container": "#6063ee",
                        "surface-bright": "#f8f9fa",
                        "outline": "#777587",
                        "surface-container-low": "#f3f4f5",
                        "tertiary-container": "#a44100",
                        "on-primary-container": "#dad7ff",
                        "surface-container-lowest": "#ffffff",
                        "on-error-container": "#93000a",
                        "outline-variant": "#c7c4d8",
                        "surface-container-high": "#e7e8e9",
                        "on-tertiary-fixed-variant": "#7b2f00",
                        "on-secondary-fixed": "#07006c"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "gutter": "1.5rem",
                        "stack_gap_sm": "0.5rem",
                        "stack_gap_md": "1rem",
                        "container_padding": "2rem",
                        "navbar_height": "64px",
                        "sidebar_width": "240px"
                    },
                    "fontFamily": {
                        "headline-md": ["Inter"],
                        "display-sm": ["Inter"],
                        "body-lg-reg": ["Inter"],
                        "body-sm-medium": ["Inter"],
                        "body-sm-reg": ["Inter"],
                        "label-caps": ["Inter"],
                        "body-lg-bold": ["Inter"]
                    },
                    "fontSize": {
                        "headline-md": ["18px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "display-sm": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "body-lg-reg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "body-sm-medium": ["14px", { "lineHeight": "20px", "fontWeight": "500" }],
                        "body-sm-reg": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "label-caps": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700" }],
                        "body-lg-bold": ["16px", { "lineHeight": "24px", "fontWeight": "600" }]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-background min-h-screen flex flex-col items-center justify-center p-gutter">
    <div class="w-full max-w-md mx-auto">

        <!-- Logo -->
        <div class="text-center mb-8">
            <span class="font-display-sm text-display-sm font-bold text-primary tracking-tight">NMail</span>
        </div>

        <!-- Kart -->
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 p-8 sm:p-10 shadow-[0px_1px_3px_rgba(0,0,0,0.05),_0px_1px_2px_rgba(0,0,0,0.03)] text-center flex flex-col items-center">

            <!-- Görsel İllüstrasyon -->
            <div class="mb-6 w-32 h-32 flex items-center justify-center">
                <img alt="Zarf Görseli" class="w-full h-auto object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC_SUIZWhdDBYGcbMlhx_HCsPChVXT-Wsf54f52hvk5rtejk6bDkNX5ljKwhDBLGrACLy7acVAltU-caWR3bTlFLQgerpnNu4SspgIhJv1hc24lCdTxFxEPsXVKta6mRQVF-Tgkdw3ZxIx_ca_aHaaeQlW7dZBbduX-pSqp5WBYqFjLE6Qg6GeNOAmRXL8g6uhXgZFswM1Vt60UCn-DpeBorJYsEpDDFl1A8hw1-ZUAFjALwymm9NVpyQ" />
            </div>

            <!-- Başlık -->
            <h1 class="font-display-sm text-display-sm text-on-surface mb-3">E-posta Adresinizi Doğrulayın</h1>

            <!-- Açıklama Metni -->
            <p class="font-body-lg-reg text-body-lg-reg text-on-surface-variant mb-8 px-2">
                E-posta adresinize bir doğrulama bağlantısı gönderdik. Hesabınızı aktifleştirmek ve kullanmaya başlamak için lütfen gelen kutunuzdaki bağlantıya tıklayın.
            </p>

            <!-- Mesaj/Bildirim Alanları -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="w-full mb-6 p-3 rounded-lg bg-surface-container-low border border-primary/20 text-primary text-body-sm-reg text-sm text-center">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="w-full mb-6 p-3 rounded-lg bg-error-container/40 border border-error/20 text-error text-body-sm-reg text-sm text-center">
                    @TempData["ErrorMessage"]
                </div>
            }

            <!-- Eylemler -->
            <div class="w-full flex flex-col gap-4 items-center">
                <!-- Doğrulama Kodunu Tekrar Gönder Formu -->
                <form asp-action="ResendEmail" asp-controller="Auth" method="post" class="w-full">
                    <input type="hidden" name="email" value="@ViewBag.Email" />
                    <button type="submit" class="w-full bg-surface-container-lowest border border-outline-variant text-on-surface font-body-sm-medium text-body-sm-medium py-2.5 px-4 rounded-lg hover:bg-surface-container-low transition-colors duration-200">
                        Doğrulama E-postasını Tekrar Gönder
                    </button>
                </form>

                <!-- Bir önceki sayfaya (Kayıt ol / Giriş yap) Geçiş Bağlantısı -->
                <a class="font-body-sm-medium text-body-sm-medium text-primary hover:text-primary-container transition-colors duration-200 flex items-center gap-1" href="@Url.Action("Register", "Auth")">
                    <span class="material-symbols-outlined text-sm">arrow_back</span>
                    Farklı bir e-posta ile kayıt ol
                </a>
            </div>

        </div>
    </div>
</body>
</html>