@model RegisterDto
@{
    Layout = null;
    ViewData["Title"] = "Kayıt Ol";
}
   
<!DOCTYPE html>

<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>NMail - @ViewData["Title"]</title>
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Tailwind Configuration -->
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-tint": "#4d44e3",
                        "tertiary-fixed": "#ffdbcc",
                        "on-primary": "#ffffff",
                        "inverse-primary": "#c3c0ff",
                        "secondary-container": "#6063ee",
                        "on-primary-container": "#dad7ff",
                        "secondary-fixed-dim": "#c0c1ff",
                        "error": "#ba1a1a",
                        "on-error-container": "#93000a",
                        "on-secondary": "#ffffff",
                        "on-tertiary-fixed": "#351000",
                        "primary-fixed": "#e2dfff",
                        "tertiary-container": "#a44100",
                        "on-secondary-fixed-variant": "#2f2ebe",
                        "surface-container-lowest": "#ffffff",
                        "on-error": "#ffffff",
                        "tertiary-fixed-dim": "#ffb695",
                        "primary-fixed-dim": "#c3c0ff",
                        "surface-dim": "#d9dadb",
                        "inverse-surface": "#2e3132",
                        "on-surface": "#191c1d",
                        "surface-container-highest": "#e1e3e4",
                        "secondary-fixed": "#e1e0ff",
                        "inverse-on-surface": "#f0f1f2",
                        "tertiary": "#7e3000",
                        "on-primary-fixed-variant": "#3323cc",
                        "surface-container": "#edeeef",
                        "on-secondary-container": "#fffbff",
                        "outline-variant": "#c7c4d8",
                        "primary": "#3525cd",
                        "on-tertiary-container": "#ffd2be",
                        "on-surface-variant": "#464555",
                        "secondary": "#4648d4",
                        "on-primary-fixed": "#0f0069",
                        "surface-container-high": "#e7e8e9",
                        "on-tertiary": "#ffffff",
                        "error-container": "#ffdad6",
                        "surface-variant": "#e1e3e4",
                        "surface-container-low": "#f3f4f5",
                        "on-background": "#191c1d",
                        "outline": "#777587",
                        "surface-bright": "#f8f9fa",
                        "surface": "#f8f9fa",
                        "on-secondary-fixed": "#07006c",
                        "primary-container": "#4f46e5",
                        "background": "#f8f9fa",
                        "on-tertiary-fixed-variant": "#7b2f00"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "gutter": "1.5rem",
                        "navbar_height": "64px",
                        "container_padding": "2rem",
                        "stack_gap_md": "1rem",
                        "stack_gap_sm": "0.5rem",
                        "sidebar_width": "240px"
                    },
                    "fontFamily": {
                        "body-lg-reg": ["Inter"],
                        "body-sm-reg": ["Inter"],
                        "display-sm": ["Inter"],
                        "body-sm-medium": ["Inter"],
                        "label-caps": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-lg-bold": ["Inter"]
                    },
                    "fontSize": {
                        "body-lg-reg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "body-sm-reg": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "display-sm": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "body-sm-medium": ["14px", { "lineHeight": "20px", "fontWeight": "500" }],
                        "label-caps": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700" }],
                        "headline-md": ["18px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-lg-bold": ["16px", { "lineHeight": "24px", "fontWeight": "600" }]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-surface text-on-surface min-h-screen flex items-center justify-center font-body-sm-reg">
    <!-- Main Container for Card -->
    <main class="w-full max-w-[440px] px-4 sm:px-0 mx-auto">
        <!-- Sign Up Card -->
        <div class="bg-surface-container-lowest rounded-lg border border-outline-variant/30 shadow-[0px_1px_3px_rgba(0,0,0,0.05),0px_1px_2px_rgba(0,0,0,0.03)] p-8 sm:p-10 w-full relative overflow-hidden">
            <!-- Logo & Header -->
            <div class="text-center mb-8">
                <h1 class="font-display-sm text-display-sm text-primary mb-2">NMail</h1>
                <p class="font-body-lg-reg text-body-lg-reg text-on-surface-variant">Hesabını Oluştur</p>
            </div>
            <!-- Form -->
            <form class="space-y-5" method="POST">
                <!-- Genel Hata / Validation Summary Alanı -->
                <div asp-validation-summary="All" class="text-body-sm-reg text-error bg-error-container/40 border border-error/20 rounded p-3 text-sm empty:hidden [&>ul]:list-disc [&>ul]:pl-5 space-y-1"></div>

                <!-- Name Fields (Row) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-body-sm-medium text-body-sm-medium text-on-surface mb-1.5" for="FirstName">İsim</label>
                        <input class="w-full bg-surface-container-low border border-outline-variant/50 rounded text-on-surface font-body-sm-reg text-body-sm-reg px-3 py-2 focus:bg-surface-container-lowest focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="FirstName" placeholder="Ayşe" type="text" />
                        <span asp-validation-for="FirstName" class="mt-1 block text-body-sm-reg text-error text-xs"></span>
                    </div>
                    <div>
                        <label class="block font-body-sm-medium text-body-sm-medium text-on-surface mb-1.5" for="LastName">Soyisim</label>
                        <input class="w-full bg-surface-container-low border border-outline-variant/50 rounded text-on-surface font-body-sm-reg text-body-sm-reg px-3 py-2 focus:bg-surface-container-lowest focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="LastName" placeholder="Yılmaz" type="text" />
                        <span asp-validation-for="LastName" class="mt-1 block text-body-sm-reg text-error text-xs"></span>
                    </div>
                </div>

                <!-- Email Field -->
                <div>
                    <label class="block font-body-sm-medium text-body-sm-medium text-on-surface mb-1.5" for="Email">Mail Adresi</label>
                    <input class="w-full bg-surface-container-low border border-outline-variant/50 rounded text-on-surface font-body-sm-reg text-body-sm-reg px-3 py-2 focus:bg-surface-container-lowest focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="Email" type="email" placeholder="ornek@mail.com" />
                    <span asp-validation-for="Email" class="mt-1 block text-body-sm-reg text-error text-xs"></span>
                </div>

                <!-- Username Field -->
                <div>
                    <label class="block font-body-sm-medium text-body-sm-medium text-on-surface mb-1.5" for="UserName">Kullanıcı Adı</label>
                    <input class="w-full bg-surface-container-low border border-outline-variant/50 rounded text-on-surface font-body-sm-reg text-body-sm-reg px-3 py-2 focus:bg-surface-container-lowest focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="UserName" type="text" placeholder="ayseyilmaz1" />
                    <span asp-validation-for="UserName" class="mt-1 block text-body-sm-reg text-error text-xs"></span>
                </div>

                <!-- Password Field -->
                <div>
                    <label class="block font-body-sm-medium text-body-sm-medium text-on-surface mb-1.5" for="Password">Şifre</label>
                    <input class="w-full bg-surface-container-low border border-outline-variant/50 rounded text-on-surface font-body-sm-reg text-body-sm-reg px-3 py-2 focus:bg-surface-container-lowest focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="Password" placeholder="••••••••" type="password" required />
                    <!-- Şifre Özel Hata Alanı -->
                    <span asp-validation-for="Password" class="mt-1 flex items-center gap-1 text-body-sm-reg text-error text-xs"></span>
                </div>

                <!-- Confirm Password Field -->
                <div>
                    <label class="block font-body-sm-medium text-body-sm-medium text-on-surface mb-1.5" for="ConfirmPassword">Şifre Tekrarı</label>
                    <input class="w-full bg-surface-container-low border border-outline-variant/50 rounded text-on-surface font-body-sm-reg text-body-sm-reg px-3 py-2 focus:bg-surface-container-lowest focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="ConfirmPassword" placeholder="••••••••" type="password" required />
                    <!-- Şifre Eşleşmeme / Tekrar Hata Alanı -->
                    <span asp-validation-for="ConfirmPassword" class="mt-1 flex items-center gap-1 text-body-sm-reg text-error text-xs"></span>
                </div>

                <!-- Action Buttons -->
                <div class="pt-2">
                    <button class="w-full bg-primary-container text-on-primary font-body-lg-bold text-body-lg-bold py-2.5 px-4 rounded hover:bg-primary transition-colors flex items-center justify-center gap-2" type="submit">
                        Kayıt Ol
                    </button>
                </div>
            </form>
            <!-- Footer Links -->
            <div class="mt-6 text-center">
                <p class="font-body-sm-reg text-body-sm-reg text-on-surface-variant">
                    Hesabın Var Mı?
                    <a class="text-primary hover:text-primary-container font-body-sm-medium transition-colors" href="/Auth/Login">Giriş Yap</a>
                </p>
            </div>
        </div>
    </main>
</body>
</html>