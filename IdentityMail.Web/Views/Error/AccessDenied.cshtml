@{
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Erişim Reddedildi - NMail</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#3525cd",
                        "primary-container": "#4f46e5",
                        "on-primary": "#ffffff",
                        "primary-fixed": "#e2dfff",
                        "background": "#f8f9fa",
                        "surface": "#f8f9fa",
                        "on-surface": "#191c1d",
                        "on-surface-variant": "#464555",
                        "surface-container-low": "#f3f4f5",
                        "surface-container-lowest": "#ffffff",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "on-error-container": "#93000a",
                        "outline": "#777587",
                        "outline-variant": "#c7c4d8"
                    },
                    fontFamily: {
                        "headline-md": ["Inter"],
                        "display-sm": ["Inter"],
                        "body-sm-reg": ["Inter"],
                        "body-lg-bold": ["Inter"],
                        "body-sm-medium": ["Inter"],
                        "label-caps": ["Inter"],
                        "body-lg-reg": ["Inter"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .icon-fill {
            font-variation-settings: 'FILL' 1;
        }
    </style>
</head>
<body class="bg-background text-on-surface font-body-lg-reg w-screen h-screen overflow-hidden flex flex-col justify-between select-none relative">

    <!-- Arka Plan Dekoratif Işık Efektleri -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-primary-fixed/40 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-error-container/30 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Üst Mini Header / Logo -->
    <header class="w-full p-6 flex items-center justify-between z-10">
        <a href="/" class="text-xl font-bold tracking-tight text-primary flex items-center gap-2">
            <span class="material-symbols-outlined text-[24px] icon-fill">mail</span>
            <span>NMail</span>
        </a>
        <span class="text-xs font-mono text-outline uppercase tracking-wider bg-surface-container-low px-3 py-1 rounded-full border border-outline-variant/50">
            HTTP 403 Forbidden
        </span>
    </header>

    <!-- Tam Ortalanmış Ana İçerik -->
    <main class="flex-1 flex items-center justify-center px-4 z-10">
        <div class="w-full max-w-2xl bg-surface-container-lowest/80 backdrop-blur-md rounded-2xl border border-outline-variant/60 shadow-[0_8px_30px_rgb(0,0,0,0.06)] p-8 sm:p-12 text-center flex flex-col items-center">

            <!-- Görsel ve İkon -->
            <div class="mb-6 w-40 h-40 sm:w-48 sm:h-48 relative flex items-center justify-center">
                <div class="absolute inset-0 bg-primary-fixed/30 rounded-full blur-xl"></div>
                <img alt="Security Illustration" class="w-full h-full object-contain relative z-10 drop-shadow-sm"
                     src="https://lh3.googleusercontent.com/aida/AP1WRLsA9isoTvoFJxDSUkcXlKSiwpXY5T9lfrcdA8C25Kcm8WXsp_FEJlg8sMA_XaJ6YDtzRDGp-cll5Vwq2u9MtAr8VBPy35k_44WNQ9C8M4ZBtuX9MS4c1UfOxGkMVlC8-oiYWWAjuZfEttDoPi0-X5KlgTlQR2965730uyv7fRDqkXiegAfv0hibq_LeiGghL3s7NiRmmqZzewpr1iH0FkknJN8PvXqTijaNDjHyAIdC-mi9tv_DwpvwGZ03" />
                <div class="absolute bottom-2 right-2 bg-surface-container-lowest rounded-full p-2.5 shadow-md border border-outline-variant/30 z-20 flex items-center justify-center">
                    <span class="material-symbols-outlined text-error text-[26px] icon-fill">block</span>
                </div>
            </div>

            <!-- Hata Rozeti -->
            <div class="inline-flex items-center gap-1.5 bg-error-container/40 text-on-error-container text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-3 border border-error/20">
                <span class="material-symbols-outlined text-[16px] icon-fill">gpp_bad</span>
                <span>Yetkisiz Erişim</span>
            </div>

            <!-- Başlık ve Açıklama -->
            <h1 class="text-2xl sm:text-3xl font-bold text-on-surface tracking-tight mb-2">Erişim Reddedildi</h1>
            <p class="text-on-surface-variant text-sm sm:text-base max-w-md mx-auto mb-8 leading-relaxed">
                Bu sayfayı veya işlemi görüntülemek için gerekli rol ve izinlere sahip değilsiniz. Lütfen sistem yöneticinizle iletişime geçin.
            </p>

            <!-- Aksiyon Butonları -->
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
                <button onclick="window.history.back()"
                        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-surface-container-lowest border border-outline-variant hover:bg-surface-container-low text-on-surface rounded-xl font-medium text-sm transition-all shadow-xs focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    Geri Dön
                </button>

                <a href="/Auth/Login"
                   class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-primary-container hover:bg-primary text-on-primary rounded-xl font-medium text-sm transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">
                    <span class="material-symbols-outlined text-[18px]">login</span>
                    Farklı Hesapla Giriş Yap
                </a>
            </div>

        </div>
    </main>

    <!-- Alt Bilgi (Footer) -->
    <footer class="w-full p-6 text-center text-xs text-outline z-10">
        &copy; @DateTime.Now.Year NMail. Tüm hakları saklıdır.
    </footer>

</body>
</html>