
@{
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>404 - Sayfa Bulunamadı | MailApp</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-tertiary-fixed-variant": "#7b2f00",
                        "surface-container-lowest": "#ffffff",
                        "on-secondary-fixed": "#07006c",
                        "surface": "#f8f9fa",
                        "on-tertiary": "#ffffff",
                        "tertiary-fixed": "#ffdbcc",
                        "on-primary-fixed-variant": "#3323cc",
                        "on-primary-fixed": "#0f0069",
                        "inverse-on-surface": "#f0f1f2",
                        "surface-container-high": "#e7e8e9",
                        "secondary": "#4648d4",
                        "on-tertiary-fixed": "#351000",
                        "on-error-container": "#93000a",
                        "surface-dim": "#d9dadb",
                        "surface-container-highest": "#e1e3e4",
                        "inverse-surface": "#2e3132",
                        "error": "#ba1a1a",
                        "primary-fixed-dim": "#c3c0ff",
                        "surface-container": "#edeeef",
                        "tertiary-fixed-dim": "#ffb695",
                        "on-secondary": "#ffffff",
                        "secondary-fixed": "#e1e0ff",
                        "outline-variant": "#c7c4d8",
                        "on-error": "#ffffff",
                        "on-secondary-container": "#fffbff",
                        "tertiary": "#7e3000",
                        "surface-container-low": "#f3f4f5",
                        "surface-bright": "#f8f9fa",
                        "surface-variant": "#e1e3e4",
                        "inverse-primary": "#c3c0ff",
                        "primary": "#3525cd",
                        "error-container": "#ffdad6",
                        "primary-fixed": "#e2dfff",
                        "on-tertiary-container": "#ffd2be",
                        "on-primary": "#ffffff",
                        "on-background": "#191c1d",
                        "surface-tint": "#4d44e3",
                        "outline": "#777587",
                        "primary-container": "#4f46e5",
                        "on-secondary-fixed-variant": "#2f2ebe",
                        "background": "#f8f9fa",
                        "on-primary-container": "#dad7ff",
                        "on-surface": "#191c1d",
                        "secondary-fixed-dim": "#c0c1ff",
                        "secondary-container": "#6063ee",
                        "tertiary-container": "#a44100",
                        "on-surface-variant": "#464555"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack_gap_sm": "0.5rem",
                        "container_padding": "2rem",
                        "sidebar_width": "240px",
                        "gutter": "1.5rem",
                        "stack_gap_md": "1rem",
                        "navbar_height": "64px"
                    },
                    "fontFamily": {
                        "body-lg-reg": ["Inter"],
                        "label-caps": ["Inter"],
                        "display-sm": ["Inter"],
                        "body-sm-medium": ["Inter"],
                        "body-lg-bold": ["Inter"],
                        "body-sm-reg": ["Inter"],
                        "headline-md": ["Inter"]
                    },
                    "fontSize": {
                        "body-lg-reg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "label-caps": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700" }],
                        "display-sm": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "body-sm-medium": ["14px", { "lineHeight": "20px", "fontWeight": "500" }],
                        "body-lg-bold": ["16px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "body-sm-reg": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "headline-md": ["18px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600" }]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

            .material-symbols-outlined.fill-icon {
                font-variation-settings: 'FILL' 1;
            }
    </style>
</head>
<body class="bg-background text-on-surface min-h-screen flex flex-col font-body-lg-reg">
    <!-- Navbar Suppressed as per instructions for 404 dead end -->
    <!-- Main Content Canvas -->
    <main class="flex-grow flex items-center justify-center p-container_padding">
        <div class="max-w-2xl w-full text-center space-y-stack_gap_md flex flex-col items-center">
            <!-- Illustration Area -->
            <div class="relative w-64 h-64 mb-8">
                <!-- Using a sophisticated CSS illustration instead of an image placeholder to match the modern, flat aesthetic -->
                <div class="absolute inset-0 bg-surface-container rounded-full opacity-50 flex items-center justify-center">
                    <span class="material-symbols-outlined text-outline-variant" style="font-size: 120px; font-variation-settings: 'wght' 200;">mail</span>
                </div>
                <div class="absolute -bottom-4 -right-4 bg-surface-container-lowest rounded-full p-4 shadow-sm border border-outline-variant">
                    <span class="material-symbols-outlined text-primary-container" style="font-size: 48px;">search_off</span>
                </div>
            </div>
            <!-- Error Content -->
            <h1 class="text-9xl font-bold text-primary-container tracking-tighter" style="line-height: 1;">404</h1>
            <h2 class="font-display-sm text-display-sm text-on-surface mt-4">
                Aradığınız sayfa bulunamadı
            </h2>
            <p class="font-body-lg-reg text-body-lg-reg text-on-surface-variant max-w-md mx-auto mt-2">
                Ulaşmaya çalıştığınız bağlantı hatalı olabilir veya sayfa taşınmış/silinmiş olabilir. Lütfen adresi kontrol edin veya ana sayfaya dönün.
            </p>
            <!-- Actions -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
            
                <button class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary-container text-on-primary rounded-lg hover:bg-primary transition-colors focus:ring-2 focus:ring-primary focus:outline-none font-body-sm-medium text-body-sm-medium"
                             onclick="window.history.back()">
                    <span class="material-symbols-outlined mr-2">arrow_back</span>
                    Geri Dön
                </button>
            </div>
        </div>
    </main>
</body>
</html>